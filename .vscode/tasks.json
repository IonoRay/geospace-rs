{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "geospace: build NRLMSIS 2.1",
      "type": "process",
      "command": "nix",
      "args": [
        "develop", ".#default", "--command", "env", "IONORAY_OFFLINE=1",
        "cargo", "build", "--locked", "--offline", "--package", "ionoray-msis",
        "--example", "nrlmsis21_explicit_input"
      ],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": ["$rustc"]
    },
